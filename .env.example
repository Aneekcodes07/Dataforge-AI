# -----------------------------------------------------------------------------
# DataForge AI — Environment Configuration Template
# Copy this file to '.env' and fill in your custom credentials.
# -----------------------------------------------------------------------------

# --- Authentication & Secrets ---
# REQUIRED in production. Generate a strong, unique value (>= 32 chars):
#   openssl rand -hex 32
# With DEBUG=false the backend refuses to start using this placeholder.
SECRET_KEY=prod-secret-key-change-in-production

# --- Database Configurations ---
# Defaults mapping to postgres and redis containers inside docker-compose
POSTGRES_DB=dataforge_ai
POSTGRES_USER=dataforge
POSTGRES_PASSWORD=secure_pass
DATABASE_URL=postgresql://dataforge:secure_pass@postgres:5432/dataforge_ai
REDIS_URL=redis://redis:6379/0

# --- Object Storage (S3-compatible: AWS S3, MinIO, Cloudflare R2) ---
# In Docker Compose these default to the bundled MinIO service. For production
# point STORAGE_ENDPOINT_URL at your provider (leave empty for native AWS S3).
STORAGE_ENDPOINT_URL=http://minio:9000
STORAGE_BUCKET=dataforge
STORAGE_ACCESS_KEY=dataforge
STORAGE_SECRET_KEY=dataforge_secret
STORAGE_REGION=us-east-1

# --- LLM API Keys (Required for Copilot and AI Extraction Agents) ---
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# --- System Config ---
# DEBUG must be false in production (enables the strong-secret startup guard).
# Set DEBUG=true only for local development.
DEBUG=false
LOG_FORMAT=json
PORT=8000

# --- Sentry Error Monitoring & Telemetry ---
SENTRY_DSN=your_backend_sentry_dsn_here
SENTRY_TRACES_SAMPLE_RATE=0.1
VITE_SENTRY_DSN=your_frontend_sentry_dsn_here

# --- Grafana Visualization Settings ---
GRAFANA_ADMIN_PASSWORD=admin
