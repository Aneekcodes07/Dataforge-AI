{
    "compilerOptions": {
        "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
        "target": "es2023",
        "lib": [
            "es2023",
            "dom"
        ],
        "module": "esnext",
        "types": [
            "vite/client"
        ],
        "skipLibCheck": true,
        "baseUrl": "./",
        "ignoreDeprecations": "6.0",
        "paths": {
            "@/*": [
                "src/*"
            ]
        },
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "verbatimModuleSyntax": true,
        "moduleDetection": "force",
        "noEmit": true,
        "jsx": "react-jsx",
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "erasableSyntaxOnly": true,
        "noFallthroughCasesInSwitch": true,
        "isolatedModules": true,
        "preserveConstEnums": true
    },
    "files": [
        "./src/App.tsx",
        "./src/main.tsx",
        "./src/components/layout/AppShell.tsx",
        "./src/components/layout/CommandPalette.tsx",
        "./src/components/layout/Navbar.tsx",
        "./src/components/layout/Sidebar.tsx",
        "./src/lib/api.ts",
        "./src/lib/constants.ts",
        "./src/lib/utils.ts",
        "./src/lib/websocketService.ts",
        "./src/pages/Agents/AgentNetworkPage.tsx",
        "./src/pages/Auth/LoginPage.tsx",
        "./src/pages/Auth/SignupPage.tsx",
        "./src/pages/Copilot/CopilotPage.tsx",
        "./src/pages/Dashboard/DashboardPage.tsx",
        "./src/pages/Dashboard/components/ActivityFeed.tsx",
        "./src/pages/Dashboard/components/QuickStart.tsx",
        "./src/pages/Dashboard/components/RecentProjects.tsx",
        "./src/pages/Dashboard/components/StatsCards.tsx",
        "./src/pages/DatasetExplorer/DatasetDetailPage.tsx",
        "./src/pages/DatasetExplorer/DatasetExplorerPage.tsx",
        "./src/pages/Extraction/ExtractionPage.tsx",
        "./src/pages/Extraction/components/SourceForms.tsx",
        "./src/pages/History/HistoryPage.tsx",
        "./src/pages/History/PipelineDetailPage.tsx",
        "./src/pages/Landing/LandingPage.tsx",
        "./src/pages/Landing/components/AgentPreview.tsx",
        "./src/pages/Landing/components/FeaturesGrid.tsx",
        "./src/pages/Landing/components/FooterSection.tsx",
        "./src/pages/Landing/components/HeroSection.tsx",
        "./src/pages/Landing/components/HowItWorks.tsx",
        "./src/pages/Landing/components/LandingSectionHeader.tsx",
        "./src/pages/Landing/components/ProductPreview.tsx",
        "./src/pages/Notifications/NotificationsPage.tsx",
        "./src/pages/Settings/SettingsPage.tsx",
        "./src/stores/agentStore.ts",
        "./src/stores/authStore.ts",
        "./src/stores/projectStore.ts",
        "./src/stores/uiStore.ts",
        "./src/styles/animations.ts"
    ],
    "include": [
        "src"
    ]
}
